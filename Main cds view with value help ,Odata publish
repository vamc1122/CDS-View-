CLASS ZCL_GET_SALES_DETAILS IMPLEMENTATION.
 method  get_data by database function for hdb
                  language sqlscript options read-only
                  using /BIC/AZSD_O0800 /BI0/TMATERIAL  /BI0/TMATL_GROUP.

*it_preqty = select  from  "/BIC/AZSD_O0800" where DOC_NUMBER = '0070010104' ;

monthly_totals =
  SELECT CALMONTH, MATL_GROUP, doc_type,
CASE
  WHEN CALMONTH IS NULL
       OR LENGTH(CALMONTH) < 6
       OR LEFT( CALMONTH, 6) IN ('000000', '')
       THEN '000000'
  ELSE TO_VARCHAR(CAST(LEFT(CALMONTH, 4) AS INTEGER) + 1) || RIGHT(CALMONTH, 2)
END AS PREYEAR_MONTH,
         SUM(inv_qty) AS month_total
  FROM "/BIC/AZSD_O0800"
*  WHERE PLANT IN ('1700', '2700' )
*  and matl_group in ( 'Z043','Z049','Z045','Z047',
*  'Z050','Z051','Z069','Z070','Z072','Z075','Z074','Z077' )
  GROUP BY CALMONTH ,matl_group,doc_type;

curr_qty =
SELECT
  CALMONTH,
  MATL_GROUP,
  doc_type,
  SUM(INV_QTY) AS TOTAL_INV_QTY
FROM "/BIC/AZSD_O0800"
*WHERE PLANT IN ('1700', '2700')
GROUP BY CALMONTH, MATL_GROUP, doc_type;

 final =  select a.DOC_NUMBER as DOC_NUMBER,
                a.S_ORD_ITEM as S_ORD_ITEM,
                a.BILL_NUM   as BILL_NUM,
                a.BILL_ITEM  as BILL_ITEM,
                a.RECORDMODE as RECORDMODE,
                a.COMP_CODE  as COMP_CODE,
                a.PLANT      as Plant,
                a.SHIP_TO    as SHIP_TO,
                a.SOLD_TO    as SOLD_TO,
                a.BILLTOPRTY as BILLTOPRTY,
                a.PAYER      as PAYER,
                a.MATERIAL   as MATERIAL,
                b.txtmd      as MAT_Desc,
                a.DOC_TYPE   as DOC_TYPE,
                a.bill_type  as BILL_TYPE,
                a.DISTR_CHAN as DISTR_CHAN,
                a.DIVISION   as DIVISION,
                a.BASE_UOM   as BASE_UOM,
                a.CALDAY     as CALDAY,
                a.CALMONTH   as CALMONTH,
                a.FISCYEAR   as FISCYEAR,
*                //premonth
CASE
  WHEN a.CALMONTH IS NULL
       OR LENGTH(a.CALMONTH) < 6
       OR LEFT( a.CALMONTH, 6) IN ('000000', '')
       THEN '000000'
  ELSE TO_VARCHAR(CAST(LEFT(a.CALMONTH, 4) AS INTEGER) - 1) || RIGHT(a.CALMONTH, 2)
END AS PREYEAR_MONTH,
                a.CALWEEK    as CALWEEK,
                a.FISCPER    as FISCPER,
*                //preyear
CASE
  WHEN a.FISCYEAR IS NULL
       OR LENGTH(a.FISCYEAR) < 4
       OR LEFT(a.FISCYEAR, 4) IN ('0000', '')
       THEN '0000'
  ELSE TO_VARCHAR(CAST(LEFT(a.FISCYEAR, 4) AS INTEGER) - 1)
END AS PREYEAR,
                a.FISCVARNT  as FISCVARNT,
                a.MATL_GROUP as MATL_GROUP,
                c.txtsh      as MGRP_desc,
                a.BILL_DATE  as BILL_DATE,
                a.NETVAL_INV as NETVAL_INV,
                a.DOC_CURRCY as DOC_CURRCY,
                a.inv_qty    as INV_QTY,
                a.unit       as UNIT,
                a.quantity   as QUANTITY,
                m.month_total AS PREINV_QTY,
                q.TOTAL_INV_QTY AS Row_PREINV_QTY,
 ROW_NUMBER() OVER (
      PARTITION BY a.CALMONTH, a.MATL_GROUP, a.doc_type
      ORDER BY a.DOC_NUMBER
    ) AS rn,
*  CASE
*    WHEN row_number() OVER (PARTITION BY a.CALMONTH order by  a.calmonth ) = 1
*    THEN m.month_total
*    ELSE NULL
*  END AS Row_PREINV_QTY,

                a.sales_unit as SALES_UNIT
  from "/BIC/AZSD_O0800" as a
  left outer join  "/BI0/TMATERIAL" as b
  ON a.material  = b.material left outer join "/BI0/TMATL_GROUP" as c
  on a.MATL_GROUP = c.matl_group left outer JOIN :monthly_totals AS m  ON a.calmonth  = m.PREYEAR_MONTH and a.matl_group = m.MATL_GROUP and a.doc_type =  m.doc_type
  left outer join :curr_qty as q on a.calmonth  = q.CALMONTH and a.matl_group = q.MATL_GROUP and a.doc_type =  q.doc_type;
*   where a.PLANT in ( '1700','2700' ) ;
*    and a.MATL_GROUP in ( 'Z043','Z049','Z045','Z047',
*  'Z050','Z051','Z069','Z070','Z072','Z072','Z075','Z074','Z077' );
*    order by DOC_NUMBER ,  S_ORD_ITEM;

RETURN
SELECT          DOC_NUMBER,
                S_ORD_ITEM,
                BILL_NUM,
                BILL_ITEM,
                RECORDMODE,
                COMP_CODE,
                Plant,
                SHIP_TO,
                SOLD_TO,
                BILLTOPRTY,
                PAYER,
                MATERIAL,
                MAT_Desc,
                DOC_TYPE,
                BILL_TYPE,
                DISTR_CHAN,
                DIVISION,
                BASE_UOM,
                CALDAY,
                CALMONTH,
                FISCYEAR,
               PREYEAR_MONTH,
                CALWEEK,
                FISCPER,
               PREYEAR,
                FISCVARNT,
                MATL_GROUP,
                MGRP_desc,
                BILL_DATE,
                NETVAL_INV,
                DOC_CURRCY,
                INV_QTY,
                UNIT,
                QUANTITY,
                PREINV_QTY,
                Row_PREINV_QTY,
                sales_unit as SALES_UNIT
 FROM :final
WHERE rn = 1;


endmethod.
ENDCLASS.


